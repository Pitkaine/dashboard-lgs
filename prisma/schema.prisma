// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODELES EXISTANTS (site principal)
// ==========================================

model Team {
  id          Int    @id @default(autoincrement())
  img         String
  name        String
  job         String
  job2        String
  imgPosition String @default("center")
}

model Article {
  id              Int       @id @default(autoincrement())
  language        Language
  linkedArticleId Int?
  title           String    @db.VarChar(255)
  description     String    @db.Text
  type            String    @db.VarChar(255)
  content         String    @db.LongText
  contentImg      Json
  thumbnail       String
  banner          String
  statut          String    @default("0")
  views           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([language])
  @@index([statut])
  @@index([linkedArticleId])
}

// ==========================================
// MODELES DASHBOARD CMS (lecture seule)
// ==========================================

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String
  role     String @default("admin")
}

model Page {
  id        Int           @id @default(autoincrement())
  slug      String        @unique
  type      PageType
  status    Status        @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  contents  PageContent[]
  seo       PageSeo[]
}

model PageContent {
  id        Int      @id @default(autoincrement())
  pageId    Int
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  language  Language
  title     String
  body      Json
  updatedAt DateTime @updatedAt

  @@unique([pageId, language])
  @@index([pageId])
  @@index([language])
}

model PageSeo {
  id              Int      @id @default(autoincrement())
  pageId          Int
  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  language        Language
  metaTitle       String
  metaDescription String   @db.Text
  ogImage         String?
  jsonLd          Json?

  @@unique([pageId, language])
  @@index([pageId])
  @@index([language])
}

model Wedding {
  id        Int              @id @default(autoincrement())
  slug      String           @unique
  date      DateTime
  status    Status           @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  details   WeddingContent[]
  media     WeddingMedia[]
}

model WeddingContent {
  id          Int      @id @default(autoincrement())
  weddingId   Int
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  language    Language
  title       String
  location    String
  venue       String?
  description String   @db.Text
  body        Json?

  @@unique([weddingId, language])
  @@index([weddingId])
  @@index([language])
}

model WeddingMedia {
  id        Int       @id @default(autoincrement())
  weddingId Int
  wedding   Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  thumbnail String?
  caption   String?
  position  Int       @default(0)
  isCover   Boolean   @default(false)

  @@index([weddingId])
  @@index([type])
}

model PricingPlan {
  id        Int              @id @default(autoincrement())
  slug      String           @unique
  price     String
  isPopular Boolean          @default(false)
  position  Int              @default(0)
  status    Status           @default(PUBLISHED)
  contents  PricingContent[]
  features  PricingFeature[]
}

model PricingContent {
  id          Int         @id @default(autoincrement())
  planId      Int
  plan        PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  language    Language
  name        String
  subtitle    String?
  description String?     @db.Text

  @@unique([planId, language])
  @@index([planId])
  @@index([language])
}

model PricingFeature {
  id       Int         @id @default(autoincrement())
  planId   Int
  plan     PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  language Language
  text     String
  included Boolean     @default(true)
  position Int         @default(0)

  @@index([planId])
  @@index([language])
}

model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
  group String
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  note      Int      @default(5)
  picture   String?
  review    String   @db.Text
  source    String   @default("google")
  status    Status   @default(PUBLISHED)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([status])
}

// ==========================================
// ENUMS
// ==========================================

enum PageType {
  SERVICE
  GEO
  LANDING
  LEGAL
  BLOG
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Language {
  fr
  en
}

enum MediaType {
  PHOTO
  VIDEO
  YOUTUBE
}

model FaqItem {
  id        Int          @id @default(autoincrement())
  position  Int          @default(0)
  status    Status       @default(PUBLISHED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  contents  FaqContent[]

  @@index([status])
}

model FaqContent {
  id        Int      @id @default(autoincrement())
  faqItemId Int
  faqItem   FaqItem  @relation(fields: [faqItemId], references: [id], onDelete: Cascade)
  language  Language
  question  String   @db.Text
  answer    String   @db.Text

  @@unique([faqItemId, language])
  @@index([faqItemId])
  @@index([language])
}

// Options tarifaires (gérées depuis le dashboard)
model PricingOption {
  id        Int                    @id @default(autoincrement())
  price     String?                // Prix interne (visible admin uniquement)
  position  Int                    @default(0)
  status    Status                 @default(PUBLISHED)
  contents  PricingOptionContent[]

  @@index([status])
}

model PricingOptionContent {
  id          Int            @id @default(autoincrement())
  optionId    Int
  option      PricingOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  language    Language
  name        String
  description String         @db.Text

  @@unique([optionId, language])
  @@index([optionId])
  @@index([language])
}

// Informations pratiques (gérées depuis le dashboard)
model PracticalInfo {
  id        Int                    @id @default(autoincrement())
  position  Int                    @default(0)
  status    Status                 @default(PUBLISHED)
  contents  PracticalInfoContent[]

  @@index([status])
}

model PracticalInfoContent {
  id             Int            @id @default(autoincrement())
  practicalInfoId Int
  practicalInfo  PracticalInfo  @relation(fields: [practicalInfoId], references: [id], onDelete: Cascade)
  language       Language
  text           String         @db.Text

  @@unique([practicalInfoId, language])
  @@index([practicalInfoId])
  @@index([language])
}

// ==========================================
// MESSAGES DE CONTACT
// ==========================================

model ContactMessage {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  phone        String?
  weddingDate  String?
  venue        String?
  guests       String?
  serviceType  String?
  referral     String?
  message      String   @db.Text
  locale       String   @default("fr") @db.VarChar(5)
  isRead       Boolean  @default(false)
  emailSent    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}
